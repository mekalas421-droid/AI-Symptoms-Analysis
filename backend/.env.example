ENV=production
DEBUG=false

# Use a strong randomly generated string for production
JWT_SECRET_KEY=
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
REFRESH_TOKEN_EXPIRE_MINUTES=10080

# Production Database (MUST be remote database for Vercel)
# Use Railway MYSQL_PUBLIC_URL or individual components
MYSQL_PUBLIC_URL=mysql+aiomysql://root:root@localhost:3306/railway
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=root
MYSQL_DB=railway

MONGO_URI=
MONGO_DB_NAME=medassist_logs

# Use a JSON array or comma-separated string for CORS
CORS_ORIGINS=["https://your-production-url.vercel.app"]